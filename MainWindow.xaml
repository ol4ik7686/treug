<!-- MainWindow.xaml -->
<Window x:Class="treug.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Определение типа треугольника" Height="400" Width="600"
        Background="#FF2BA443">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Введите длины сторон треугольника"  
                   Foreground="#FF020202" FontSize="16" HorizontalAlignment="Center" Margin="0,0,0,20" VerticalAlignment="Center"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,20">
            <TextBox x:Name="TbSideA" Width="80" Margin="10" PreviewTextInput="Tb_PreviewTextInput"/>
            <TextBox x:Name="TbSideB" Width="80" Margin="10" PreviewTextInput="Tb_PreviewTextInput"/>
            <TextBox x:Name="TbSideC" Width="80" Margin="10" PreviewTextInput="Tb_PreviewTextInput"/>
        </StackPanel>

        <Button x:Name="BtnCheck" Grid.Row="2" Content="Проверить" 
                Width="120" Height="35" Background="#FFEDEDED" Foreground="Black"
                Click="BtnCheck_Click" Margin="0,0,0,20"/>

        <TextBlock x:Name="TbResult" Grid.Row="3" 
                   Text="" Foreground="White" FontSize="16" 
                   HorizontalAlignment="Center" VerticalAlignment="Top"/>
    </Grid>
</Window>
